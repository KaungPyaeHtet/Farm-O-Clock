# Copy to .env.local (never commit real keys).
# Supabase → Project Settings → API Keys. Use the SECRET key (server-only).
# Leave empty to run without a database (live NASA calls, no observations).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Python model API (backend/). Local: http://localhost:8000 — leave empty to hide model panels.
BACKEND_URL=
# Optional shared secret; must match BACKEND_API_KEY on the backend.
BACKEND_API_KEY=
